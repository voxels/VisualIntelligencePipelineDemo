<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandboxed Mac app -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Local network access for Bonjour edge node discovery -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- CloudKit for SwiftData sync -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.secretatomics.visualintelligence</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- App Groups shared with iOS app -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.secretatomics.visualintelligence</string>
    </array>
</dict>
</plist>

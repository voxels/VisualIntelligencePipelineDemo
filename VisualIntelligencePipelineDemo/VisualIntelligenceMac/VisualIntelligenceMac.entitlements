<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandboxed Mac app -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Local network access for Bonjour edge node discovery -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Camera access for Continuity Camera / file import -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- CloudKit — must match iOS container IDs exactly -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.secretatomics.knowmaps.Cache</string>
        <string>iCloud.com.secretatomics.knowmaps.Keys</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Push for CloudKit change notifications -->
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
    <!-- App Group shared with iOS app (UserDefaults, file coordination) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.secretatomics.VisualIntelligence</string>
    </array>
</dict>
</plist>
